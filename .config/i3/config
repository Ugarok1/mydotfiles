set $mod Mod4

font pango:monospace 8

exec --no-startup-id dex --autostart --environment i3

exec --no-startup-id xss-lock --transfer-sleep-lock -- i3lock --nofork

# and nm-applet is a desktop environment-independent system tray GUI for it.
exec --no-startup-id nm-applet

# Use Mouse+$mod to drag floating windows to their wanted position
floating_modifier $mod

# or left-clicking anywhere into the window while holding the floating modifier.
tiling_drag modifier titlebar

# volume binds
bindsym F3 exec amixer -q set Master 5%+
bindsym F2 exec amixer -q set Master 5%-
bindsym F1 exec amixer -q set Master toggle

# start a terminal
bindsym $mod+Return exec i3-sensible-terminal ; exec --no-startup-id /home/myka/.config/i3/scripts/move-cursor-to-focused

# kill focused window
bindsym $mod+Shift+q kill ; exec --no-startup-id ~/.config/i3/scripts/move-cursor-to-focused

# start dmenu (a program launcher)
bindsym $mod+d exec --no-startup-id dmenu_run
# change focus
bindsym $mod+h focus left ; exec --no-startup-id ~/.config/i3/scripts/move-cursor-to-focused
bindsym $mod+j focus down ; exec --no-startup-id ~/.config/i3/scripts/move-cursor-to-focused
bindsym $mod+k focus up ; exec --no-startup-id ~/.config/i3/scripts/move-cursor-to-focused
bindsym $mod+l focus right ; exec --no-startup-id ~/.config/i3/scripts/move-cursor-to-focused

# move focused window
bindsym $mod+Shift+h move left ; exec --no-startup-id ~/.config/i3/scripts/move-cursor-to-focused
bindsym $mod+Shift+j move down ; exec --no-startup-id ~/.config/i3/scripts/move-cursor-to-focused
bindsym $mod+Shift+k move up ; exec --no-startup-id ~/.config/i3/scripts/move-cursor-to-focused
bindsym $mod+Shift+l move right ; exec --no-startup-id ~/.config/i3/scripts/move-cursor-to-focused

# enter fullscreen mode for the focused container
bindsym $mod+f fullscreen toggle

# toggle tiling / floating
bindsym $mod+Shift+space floating toggle

# change focus between tiling / floating windows
bindsym $mod+space focus mode_toggle

# We use variables to avoid repeating the names in multiple places.
set $ws1 "1" ; exec --no-startup-id ~/.config/i3/scripts/move-cursor-to-focused
set $ws2 "2" ; exec --no-startup-id ~/.config/i3/scripts/move-cursor-to-focused
set $ws3 "3" ; exec --no-startup-id ~/.config/i3/scripts/move-cursor-to-focused
set $ws4 "4" ; exec --no-startup-id ~/.config/i3/scripts/move-cursor-to-focused
set $ws5 "5" ; exec --no-startup-id ~/.config/i3/scripts/move-cursor-to-focused
set $ws6 "6" ; exec --no-startup-id ~/.config/i3/scripts/move-cursor-to-focused
set $ws7 "7" ; exec --no-startup-id ~/.config/i3/scripts/move-cursor-to-focused
set $ws8 "8" ; exec --no-startup-id ~/.config/i3/scripts/move-cursor-to-focused
set $ws9 "9" ; exec --no-startup-id ~/.config/i3/scripts/move-cursor-to-focused

# switch to workspace
bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9

# move focused container to workspace
bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

# reload the configuration file
bindsym $mod+Shift+c reload
# restart i3 inplace (preserves your layout/session, can be used to upgrade i3)
bindsym $mod+Shift+r restart
# exit i3 (logs you out of your X session)
bindsym $mod+Shift+e exec "i3-nagbar -t warning -m 'You pressed the exit shortcut. Do you really want to exit i3? This will end your X session.' -B 'Yes, exit i3' 'i3-msg exit'"
# UGmenu
bindsym $mod+m exec "python3 ~/.config/UGmenu/main.py"
# galculator
for_window [class="Galculator"] floating enable, move position center, resize set 300 400

# resize window (you can also use the mouse for that)
mode "resize" {
        # Pressing down will grow the window’s height.
        bindsym h resize shrink width 10 px or 10 ppt
        bindsym j resize grow height 10 px or 10 ppt
        bindsym k resize shrink height 10 px or 10 ppt
        bindsym l resize grow width 10 px or 10 ppt

        # back to normal: Enter or Escape or $mod+r
        bindsym Return mode "default"
        bindsym Escape mode "default"
        bindsym $mod+r mode "default"
}

bindsym $mod+r mode "resize"

# background
exec --no-startup-id feh --bg-fill --randomize ~/images/wallpapers/

# focus follow mouse
focus_follows_mouse no

# sync start
exec --no-startup-id syncthing --no-browser

# assign obsidian
assign [class="obsidian"] 3

# start script for autostarts
exec --no-startup-id ~/.config/i3/scripts/startautoapps.sh 

# assign calendar for floating
for_window [class="Yad" title="yad-calendar"] floating enable

# Enable smart gaps: no gaps when only one window
smart_gaps on

# Set gaps for 2 or more windows
gaps inner 10
gaps outer 10

# starting picom
exec --no-startup-id picom -b

# Border width
default_border pixel 2
new_window pixel 2

# Focused window
client.focused          #ffd966 #f7c84b #f0e1b0 #f0e1b0 #f7c84b
# Focused but inactive window
client.focused_inactive #f7c84b #f0d080 #f0e1b0 #f0e1b0 #f0d080
# Unfocused window
client.unfocused        #f0d080 #f0e1b0 #f7c84b #f7c84b #f0e1b0
# Urgent window
client.urgent           #ffb347 #ffd966 #f0e1b0 #f0e1b0 #ffb347
# Placeholder windows
client.placeholder      #ffd966 #f7c84b #f0e1b0 #f0e1b0 #f7c84b

exec_always --no-startup-id ~/.config/polybar/launch.sh
